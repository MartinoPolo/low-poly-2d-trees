# Database
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# App URL (used for OAuth redirects and passkey rpID)
ORIGIN="http://localhost:5173"

# Google OAuth (optional — auth works without these)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:5173/api/auth/callback/google as an authorized redirect URI
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional — auth works without these)
# 1. Go to https://github.com/settings/developers → New OAuth App
# 2. Set the callback URL to http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
